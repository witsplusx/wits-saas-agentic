        <mxCell id="HZ5vjw6_oLv5fQDq656t-1" value="编程/设计工具：Trae OpenHands&amp;nbsp; &amp;nbsp;视频生成：MoneyPrinterTurbo / Kilo Code / Zion&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-weight: 400; text-wrap-mode: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%E6%B7%B1%E5%BA%A6%E7%A0%94%E7%A9%B6%EF%BC%9ADeer-Flow%22%20style%3D%22rounded%3D1%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3BfontStyle%3D1%3BfillColor%3D%23dae8fc%3BstrokeColor%3D%236c8ebf%3Balign%3Dleft%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%221800%22%20y%3D%221767.39%22%20width%3D%221020%22%20height%3D%2224.61%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3EMagentic-UI&amp;nbsp; &amp;nbsp;shi&amp;nbsp;&amp;nbsp;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
