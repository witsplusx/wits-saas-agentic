        <mxCell id="HZ5vjw6_oLv5fQDq656t-12" value="语义识别：&lt;br&gt;https://www.alibabacloud.com/help/zh/pai/use-cases/llm-based-intent-recognition-solution&lt;br&gt;https://github.com/yanyg123/llm_intend&lt;div&gt;https://github.com/answerlink/IntelliQ&lt;/div&gt;&lt;div&gt;https://github.com/laixiangran/ai-learn/tree/main&lt;/div&gt;&lt;div&gt;https://www.53ai.com/news/hangyeyingyong/2024062148357.html&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 51, 51);&quot;&gt;https://github.com/aurelio-labs/semantic-router&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;https://github.com/onex7777/Llm-basedDialogueSystems&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="1" vertex="1">
